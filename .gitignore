# Environments (rebuilt per machine; the HPC one is built by setup_env.sh)
.venv/
.venv-gpu/
*.egg-info/
__pycache__/
*.py[cod]

# Experiment outputs. Results are reproducible from configs + seeds, and the
# per-task CSVs from a 75-job array would otherwise churn the history.
results/
logs/
cluster_survey.txt
wandb/
setup.log

# Tooling
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# ...but keep the Stage 2 reference summary: later stages cite it.
!results/stage2_summary.csv

# ...and keep logs/ itself in a fresh clone. Slurm opens the array's --output
# files before the job script runs, so the directory has to exist at submit time
# or all 75 tasks fail instantly with nothing written to explain it.
!logs/
!logs/.gitkeep
